{
	auto_https off
}

# NOTE: start.sh renders this file at boot, replacing __OWNER_USERNAME__ with
# the resolved OpenHost owner username, and runs Caddy against the rendered
# copy.  (Caddy's own {$ENV} substitution proved unreliable for a value
# exported at container start, so we bake it in instead.)

:3000 {
	# Strip any client-supplied auth header up front so it can never be
	# spoofed; only the owner branch below may (re)introduce it.  The
	# OpenHost router authenticates the visitor and stamps
	# X-OpenHost-Is-Owner: true for the zone owner (it strips client copies
	# of X-OpenHost-* itself).
	#
	# When the owner is present we inject Remote-User = the owner's OpenHost
	# username so Navidrome's reverse-proxy auth (ND_EXTAUTH_* / the
	# deprecated ND_REVERSEPROXY* aliases, configured in start.sh) auto-logs
	# them in under their real identity.  Non-owner traffic reaches Navidrome
	# with no Remote-User and falls through to Navidrome's normal login, so
	# Subsonic clients and share links keep working.

	# Owner requests: trust the router-stamped header, inject Remote-User.
	@owner header X-OpenHost-Is-Owner true
	handle @owner {
		reverse_proxy localhost:4533 {
			header_up Host {header.X-Forwarded-Host}
			header_up -Remote-User
			header_up Remote-User __OWNER_USERNAME__
			# Drop the inbound X-Forwarded-For (the real browser IP the
			# OpenHost router prepends) so Caddy re-adds only its own
			# loopback peer.  Navidrome then resolves the ext-auth client
			# IP to 127.0.0.1 and honours Remote-User; otherwise it walks
			# the XFF chain to the untrusted browser IP and ignores it.
			header_up -X-Forwarded-For
		}
	}

	# Everyone else: pass through with Remote-User stripped.
	handle {
		reverse_proxy localhost:4533 {
			header_up Host {header.X-Forwarded-Host}
			header_up -Remote-User
		}
	}
}
